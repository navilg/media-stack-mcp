# ==================== REQUIRED CREDENTIALS ====================

# Trakt.tv API client ID (required for Trakt features)
TRAKT_CLIENT_ID=your_trakt_client_id

# TMDB (The Movie Database) API key (required for TMDB features)
TMDB_API_KEY=your_tmdb_api_token

# ==================== OPTIONAL DEFAULTS ====================

# Default Trakt.tv username used by server tools
TRAKT_USERNAME=your_trakt_username

# ==================== MEDIA TRACKER CONFIGURATION ====================

# Media tracker source for watched media tracking
# Valid values: 'floppy' (default) or 'trakt'
TRACKED_MEDIA_SOURCE=floppy

# ==================== MEDIA DISCOVERY CONFIGURATION ====================

# Media discovery source for trending and popular content
# Valid values: 'floppy' (default) or 'trakt'
MEDIA_DISCOVERY_SOURCE=floppy

# ==================== FLOPPY INTEGRATION ====================

# Floppy instance URL (required if using Floppy features)
FLOPPY_URL=http://your-floppy-host:8000

# Floppy API key (required if using Floppy features)
# The API key needs watchlist:read scope
FLOPPY_API_KEY=your_floppy_api_key

# ==================== RADARR INTEGRATION ====================

# Radarr instance URL (required if using Radarr features)
RADARR_URL=http://your-radarr-host:7878

# Radarr API key (required if using Radarr features)
RADARR_API_KEY=your_radarr_api_key

# ==================== SONARR INTEGRATION ====================

# Sonarr instance URL (required if using Sonarr features)
SONARR_URL=http://your-sonarr-host:8989

# Sonarr API key (required if using Sonarr features)
SONARR_API_KEY=your_sonarr_api_key

# ==================== SERVER CONFIGURATION ====================

# Comma-separated list of toolsets to disable at startup
# Disables specified toolsets without removing them from registration
DISABLE_TOOLSETS=

# Bearer token for MCP HTTP server authentication (optional)
# Required for Streamable HTTP transport security
# Token must be at least 10 characters with at least 2 lowercase, 2 uppercase, and 2 digits
# If not set, authentication is disabled
MCP_AUTH_TOKEN=

# ==================== TESTING CONFIGURATION ====================

# Trakt.tv username for testing Trakt public profile features
# Used in test suite for public profile validation
TEST_TRAKT_USERNAME=your_trakt_username
